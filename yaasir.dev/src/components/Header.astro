---
const currentPath = Astro.url.pathname;
import { Sun, Moon } from "@lucide/astro";
import { Image } from "astro:assets";
import avatarImg from "@/assets/sir.png";
---

<header
  class="w-full pt-12 px-8 mx-auto max-w-3xl flex items-center justify-between"
>
  <!-- Avatar / Name -->
  <a
    href="/"
    aria-label="Home"
    class="flex items-center gap-2.5 group"
  >
    <div class="size-7 rounded-full overflow-hidden ring-1 ring-[var(--color-border-subtle)]/50 bg-[var(--color-tag-bg)] group-hover:scale-110 transition-transform duration-300 shadow-sm">
      <Image
        src={avatarImg}
        alt="Yasir Hassan"
        class="size-full object-cover object-top"
        width={28}
        height={28}
      />
    </div>
    <span class="text-sm font-semibold text-[var(--color-text-heading)] group-hover:text-[var(--color-accent)] transition-colors duration-200">
      Yasir
    </span>
  </a>

  <!-- Simple text links -->
  <nav class="flex items-center gap-6">
    <a
      href="/blog/"
      class={`text-sm transition-colors duration-200 link-underline
        ${
          currentPath.startsWith("/blog/")
            ? "text-[var(--color-text-heading)] font-medium"
            : "text-[var(--color-text-muted)] hover:text-[var(--color-accent)]"
        }`}
    >
      Blog
    </a>

    <a
      href="/Yasir_Hassan_Resume.pdf"
      target="_blank"
      class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors duration-200 flex items-center gap-1.5 link-underline"
    >
      Resume
    </a>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      aria-label="Toggle theme"
      class="ml-2 flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors duration-200"
    >
      <Sun id="icon-sun" class="size-4" />
      <Moon id="icon-moon" class="size-4 hidden" />
    </button>
  </nav>
</header>
