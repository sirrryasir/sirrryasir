---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  githubUrl?: string;
  liveUrl?: string;
}

const { title, description, githubUrl, liveUrl } = Astro.props;
---

<div class="block py-5 border-b border-[var(--color-border-subtle)]/30">
  <h3 class="text-sm font-medium text-[var(--color-text-body)] mb-1.5">
    {title}
  </h3>
  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
    {description}
  </p>

  {
    (liveUrl || githubUrl) && (
      <div class="flex items-center gap-3">
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium 
                  bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-dim)] 
                  transition-all duration-200"
          >
            Live site <ArrowUpRight class="size-3" />
          </a>
        )}
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium 
                  border border-[var(--color-border-subtle)] text-[var(--color-text-muted)] 
                  hover:text-[var(--color-text-body)] hover:border-[var(--color-text-muted)] 
                  transition-all duration-200"
          >
            GitHub <ArrowUpRight class="size-3" />
          </a>
        )}
      </div>
    )
  }
</div>
